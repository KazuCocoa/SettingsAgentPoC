{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "ollama/qwen3.5:4b",
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 (4B)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "appium-mcp": {
      "type": "local",
      "command": [
        "bash",
        "scripts/appium-mcp-with-log.sh"
      ],
      "environment": {
        "ANDROID_HOME": "{env:ANDROID_HOME}",
        "NO_UI": "true"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
